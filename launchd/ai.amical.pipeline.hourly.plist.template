<?xml version="1.0" encoding="UTF-8"?>
<!-- 定期: 1時間ごとに pipeline を実行（会議が少ない運用向け。間隔は StartInterval 秒で調整） -->
<!-- __PROJECT__ は scripts/schedule.sh が実パスへ置換して ~/Library/LaunchAgents に配置する -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.amical.pipeline.hourly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT__/scripts/pipeline.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT__/data/.logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/data/.logs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
