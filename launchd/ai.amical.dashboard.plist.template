<?xml version="1.0" encoding="UTF-8"?>
<!-- ログイン時にダッシュボードのローカルサーバー(127.0.0.1:8787)を常駐させる。 -->
<!-- __PROJECT__ は scripts/dashboard.command --install-autostart が実パスへ置換して配置する。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.amical.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__PROJECT__/dashboard/server.py</string>
    <string>--port</string>
    <string>8787</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT__/data/.logs/dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/data/.logs/dashboard.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
