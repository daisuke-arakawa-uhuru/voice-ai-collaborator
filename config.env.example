# voice-ai-collaborator ローカル設定（端末ごと）。コピーして使う:  cp config.env.example config.env
# config.env は .gitignore 済み（端末固有の好みを共有しないため）。
# pipeline.sh / ingest.sh / research.sh が読み込み、compile-note.py 等の子プロセスに継承される。

# 使う LLM モデル（LM Studio のロード済みモデル名に厳密に合わせる）。
#   速度優先: google/gemma-4-e4b（既定・軽量高速。compile 約15-17秒/本）
#   品質優先: google/gemma-4-31b（重い・約74秒/本だが高品質）
LLM_MODEL=google/gemma-4-e4b

# ステージ別に分けたい場合（ハイブリッド推奨。未設定なら LLM_MODEL を使用）:
#   COMPILE_MODEL  … 整形ノート（速度重視 → e4b）
#   RESEARCH_MODEL … 調査付き包括議事録（品質重視 → 31b）
# COMPILE_MODEL=google/gemma-4-e4b
# RESEARCH_MODEL=google/gemma-4-31b

# LLM エンドポイント（通常は変更不要）
# LLM_BASE_URL=http://localhost:1234/v1
